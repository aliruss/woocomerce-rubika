# Required: Telegram Bot API token from BotFather.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN

# Required: Telegram chat/channel ID. For channels, use @channel_username or numeric -100... ID.
TELEGRAM_CHAT_ID=@your_channel_username

# Required: Shared API key. Must match the WordPress plugin Telegram Relay API Key setting.
RELAY_API_KEY=replace-with-a-long-random-secret

# Optional: Shared HMAC secret. If set, WordPress must send X-Relay-Signature.
RELAY_HMAC_SECRET=

# Optional: comma-separated origins allowed to call this relay, e.g. https://example.com
ALLOWED_ORIGINS=

# Optional: maximum downloaded image size in MB.
MAX_IMAGE_SIZE_MB=10

# Optional: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional: temp directory for downloaded images.
TEMP_DIR=/tmp/woocommerce-telegram-relay

# Optional: local development port when running python app.py.
PORT=8000
