[Unit]
Description=WooCommerce Telegram Relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/telegram-relay
EnvironmentFile=/opt/telegram-relay/.env
ExecStart=/opt/telegram-relay/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
